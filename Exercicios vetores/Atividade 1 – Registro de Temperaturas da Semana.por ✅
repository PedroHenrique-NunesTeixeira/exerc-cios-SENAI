          maior = temperaturas[cont]
        }senao se(temperaturas[cont] < menor){
          menor = temperaturas[cont]
        }
      }

        media = (temperaturas[0] + temperaturas[1] + temperaturas[2] + temperaturas[3] + temperaturas[4] + temperaturas[5] + temperaturas[6])/ 7


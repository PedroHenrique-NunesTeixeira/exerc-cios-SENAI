programa {
  funcao inicio() {
    real temperaturas[7] 
    real maior = 0, menor = 0, media = 0
    inteiro cont = 1

    para(cont = 0; cont < 7; cont ++){
      escreva("Digite a temperatura do ", cont + 1, "° dia:")
      leia(temperaturas[cont])
      limpa()
    }

    escreva("\n--------TEMPERATURAS REGISTRADAS DIARIAS--------\n")

    para(cont = 0; cont < 7; cont ++){
      escreva("temperatura do " , cont + 1 , "° dia: ", temperaturas[cont], "\n")
    }
     /*se (cont == 1){
